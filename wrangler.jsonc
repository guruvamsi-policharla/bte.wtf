{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bte-wtf",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  },
  // Lets future content (e.g. an FAQ) be written in Markdown and imported as a string.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "routes": [
    { "pattern": "bte.wtf", "custom_domain": true },
    { "pattern": "www.bte.wtf", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
